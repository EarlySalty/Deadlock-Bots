[Unit]
Description=Deadlock Discord Insights CSV-Sync (wöchentlich)
After=network-online.target infisical.service
Wants=network-online.target

[Service]
Type=oneshot
KillMode=process
WorkingDirectory=/home/naniadm/Documents/Deadlock-Bots
LoadCredential=infisical-token:/home/naniadm/.config/infisical-tokens/infisical-token-bots
Environment=DISPLAY=:10
Environment=XAUTHORITY=/home/nathanael/.Xauthority
Environment=INSIGHTS_BRAVE_START=1
ExecStartPre=/usr/bin/bash -lc '/home/naniadm/Documents/Deadlock-Bots/scripts/wait_for_infisical.sh'
ExecStart=/usr/bin/bash -lc '/home/naniadm/Documents/Deadlock-Bots/scripts/run_dl_insights_sync.sh'
Nice=10

[Install]
WantedBy=default.target
