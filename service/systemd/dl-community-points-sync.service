[Unit]
Description=Deadlock Community-Punkte-Sync (Twitch-Punkte und Ledger in die zentrale DB)
After=network-online.target infisical.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/naniadm/Documents/Deadlock-Bots
LoadCredential=infisical-token:/home/naniadm/.config/infisical-tokens/infisical-token-bots
ExecStartPre=/usr/bin/bash -lc '/home/naniadm/Documents/Deadlock-Bots/scripts/wait_for_infisical.sh'
ExecStart=/usr/bin/bash -lc '/home/naniadm/Documents/Deadlock-Bots/scripts/run_dl_community_points_sync.sh'
TimeoutStartSec=300
Nice=10

[Install]
WantedBy=default.target
