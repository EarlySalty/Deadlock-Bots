[Unit]
Description=Deadlock Community-Punkte-Sync (Twitch-Punkte und Ledger in die zentrale DB)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/deadlock/bots/current
ExecStart=/usr/bin/sudo -n /opt/deadlock/bots/current/dl-infisical-env --token-pipe --child-no-new-privileges --config /etc/deadlock-turniere/infisical-launcher.json --uid 1000 --gid 1000 -- /opt/deadlock/bots/current/dl-community-points-sync --config /home/nathanael/.config/deadlock-bots/bot.toml
TimeoutStartSec=300
Nice=10

[Install]
WantedBy=default.target
