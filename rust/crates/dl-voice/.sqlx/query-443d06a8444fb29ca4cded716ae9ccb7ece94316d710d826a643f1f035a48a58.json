  "query": "\n        SELECT id,\n               channel_id,\n               new_name,\n               reason,\n               COALESCE(retry_count, 0) AS \"retry_count!\"\n          FROM voice.rename_requests\n         WHERE status = 'PENDING'\n         ORDER BY created_at ASC, id ASC\n         LIMIT 1\n         FOR UPDATE SKIP LOCKED\n        ",
