{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, title, url,\n               to_char(posted_at AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS') AS \"posted_at?\",\n               translated_content\n          FROM patchnotes.changelog_posts\n         WHERE translated_content IS NOT NULL\n           AND translated_content != ''\n         ORDER BY id DESC\n        ",
