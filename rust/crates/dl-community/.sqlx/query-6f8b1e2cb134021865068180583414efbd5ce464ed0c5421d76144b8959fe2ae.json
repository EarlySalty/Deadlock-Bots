  "query": "\n                SELECT bot_request_id AS \"id!: i32\",\n                       website_request_id,\n                       discord_user_id,\n                       COALESCE(discord_username, '') AS \"discord_username!\",\n                       rank,\n                       subrank,\n                       hero,\n                       games_played,\n                       hours_played,\n                       availability,\n                       current_problems,\n                       COALESCE(ai_summary, '') AS \"ai_summary!\",\n                       COALESCE(status, '') AS \"status!\",\n                       assigned_coach_id,\n                       reserved_until\n                  FROM coaching.requests\n                 WHERE bot_request_id = $1\n                ",
