  "query": "\n        SELECT id, guild_id, channel_id, channel_name, started_at, ended_at,\n               duration_seconds, points, peak_users, co_player_ids::text AS \"co_player_ids?\"\n        FROM activity.voice_session_log\n        WHERE user_id = $1\n        ORDER BY ended_at DESC, id DESC\n        LIMIT $2\n        ",
