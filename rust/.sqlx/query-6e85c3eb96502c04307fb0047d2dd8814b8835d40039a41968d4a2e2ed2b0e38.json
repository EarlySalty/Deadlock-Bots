  "query": "\n            SELECT id, coach_id, discord_user_id, voice_started_at, bot_request_id\n              FROM coaching.sessions\n             WHERE status = 'active'\n               AND survey_sent_at IS NULL\n               AND (\n                    $1::bigint IS NULL\n                    OR discord_user_id = $1\n                    OR coach_id = $2\n               )\n            ",
